# --- Core ---
NODE_ENV=development
PORT=4000
# Optional: pin password-reset links to one public URL (recommended with SMTP).
# By default they use the address the site was opened at.
PUBLIC_WEB_URL=
# Optional: serve the built web client (apps/web/dist) from the API itself.
WEB_DIST_DIR=
TRUST_PROXY=0
LOG_LEVEL=info

# --- Database / cache ---
DATABASE_URL=postgresql://poker:poker@localhost:5432/poker?schema=public
# Redis is optional for local development, but recommended and enabled in Docker.
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
WELCOME_BONUS=10000

# --- Uploads / e-mail ---
UPLOAD_DIR=./uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Chips Poker <no-reply@example.com>"

# --- Anti multi-account ---
# true is useful for local demos; production should generally keep it false.
ALLOW_MULTI_ACCOUNT=false
ALLOWED_ACCOUNTS_PER_IP_24H=3
DEVICE_COOKIE_SECRET=replace-with-another-long-random-string

# --- Game ---
TURN_TIMEOUT_MS=20000
NEXT_HAND_DELAY_MS=5000
CHAT_HISTORY_LIMIT=50
# Refund table stakes left outstanding by a crash/restart (single-node only).
RECOVER_TABLE_STAKES=true

# --- Frontend (Vite) ---
# Leave both empty when the API serves the client (Docker image, same origin).
VITE_API_URL=/api
VITE_SOCKET_URL=
